rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────

    // Is the request from a signed-in user?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Is the request from the owner of this document?
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Is the request from an admin user?
    // Uses a custom claim set via scripts/set-admin-claim.cjs.
    // Custom claims are embedded in the auth token and work correctly in
    // collection group queries (unlike get() lookups which fail in that context).
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    // Users can read and write their own profile. Admins can read all profiles.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Onboarding ──────────────────────────────────────────────────────────
    // Members can read and write their own onboarding state.
    // Admins can read and update all onboarding states (for verification).
    // Public read is allowed so the Business Directory can display vendor listings
    // without requiring authentication.  Write access remains owner/admin only.
    match /onboarding/{memberId} {
      allow read: if true;
      allow create: if isOwner(memberId);
      allow update: if isOwner(memberId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Businesses ──────────────────────────────────────────────────────────
    // Anyone can read verified businesses (public directory).
    // Only the owning vendor or an admin can write.
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      // ─── Verification Submissions (subcollection) ──────────────────────────
      // Vendors can create and read their own submissions.
      // Admins can read and update all submissions (approve/reject).
      // Cloud Functions (server-side) bypass these rules entirely.
      match /verificationSubmissions/{submissionId} {
        // Use path-based ownership: businessId in the path IS the vendor's UID.
        // resource.data cannot be used for list queries (resource is null when
        // listing a collection), so we use isOwner(businessId) from the path.
        // For collection group queries (admin), isAdmin() covers access.
        allow read: if isOwner(businessId) || isAdmin();
        allow create: if isOwner(businessId) &&
          request.resource.data.businessId == businessId;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ─── Products ────────────────────────────────────────────────────────────
    // Anyone can read products (public marketplace).
    // Only the owning vendor or an admin can write.
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.vendorId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
        (resource.data.vendorId == request.auth.uid || isAdmin());
    }

    // ─── Orders ──────────────────────────────────────────────────────────────
    // Users can read their own orders. Admins can read all orders.
    match /orders/{orderId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if false; // Orders are never deleted
    }

    // ─── Reports ─────────────────────────────────────────────────────────────
    // Any authenticated user can file a report.
    // Only admins can read or update reports (moderation queue).
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Endorsements ────────────────────────────────────────────────────────
    // Any authenticated user can read endorsements (public trust signal).
    // Any authenticated user can create an endorsement for another business.
    // Only admins can delete endorsements.
    match /endorsements/{endorsementId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ─── Message Threads ──────────────────────────────────────────────────────
    // Only participants can read or write their own threads.
    match /messageThreads/{threadId} {
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participantIds;
      allow delete: if false;
    }

    // ─── Messages ────────────────────────────────────────────────────────────
    // Only the sender or recipient can read a message thread.
    match /messages/{messageId} {
      allow read: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.recipientId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

  }
}
